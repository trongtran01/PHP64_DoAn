<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Đăng ký</title>
    <link rel="icon" href="{{ asset('frontend/images/caphe.png') }}" type="image/png">
    <style>
        /* ========== RESET & BASE ========== */
        * { box-sizing: border-box; margin: 0; padding: 0; font-family: 'Poppins', sans-serif; }
        body, html { height: 100%; background: #f6f5f7; display: flex; justify-content: center; align-items: center; }

        /* ========== CONTAINER ========== */
        .container {
            position: relative;
            width: 900px;
            max-width: 100%;
            min-height: 600px;
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 10px 50px rgba(36,32,82,0.1);
            overflow: hidden;
            display: flex;
        }

        /* ========== FORM CONTAINERS ========== */
        .form-container {
            position: absolute;
            top: 0;
            height: 100%;
            transition: all 0.6s ease-in-out;
            display: flex;
            flex-direction: column;
            justify-content: center;
            align-items: center;
            width: 50%;
            padding: 0 50px;
        }

        .sign-up-container { left: 0; z-index: 2; background-color: #FFCCCC; border-radius: 0 10px 10px 0; }
        .sign-in-container { left: 0; opacity: 0; z-index: 1; }

        /* ========== FORM ELEMENTS ========== */
        form {
            width: 100%;
            display: flex;
            flex-direction: column;
            text-align: center;
        }

        h1 {
            font-weight: bold;
            margin-bottom: 20px;
            color: #CD2626;
        }

        input {
            background: #fff;
            border: none;
            padding: 12px 15px;
            margin: 8px 0;
            width: 100%;
            border-radius: 20px;
            font-size: 16px;
        }

        input:focus {
            outline: none;
            border: 2px solid #FF4B2B;
        }

        .button {
            border-radius: 20px;
            border: 1px solid #CD2626;
            background-color: #CD2626;
            color: #fff;
            font-size: 15px;
            font-weight: bold;
            padding: 12px 45px;
            margin-top: 20px;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .button:hover {
            background-color: #fff;
            color: #CD2626;
        }

        /* ========== RESPONSIVE ========== */
        @media(max-width: 768px) {
            .container {
                width: 100%;
                flex-direction: column;
                min-height: 700px;
            }
            .form-container { width: 100%; padding: 0 30px; }
            .sign-up-container { border-radius: 0; }
        }

        /* ========== OPTIONAL MESSAGE BOX ========== */
        .sign-in-container h1 {
            font-size: 20px;
            margin-left: 0;
            color: #CD2626;
        }
    </style>
</head>
<body>
    <div class="container" id="container">
        <div class="form-container sign-up-container">
            <form method="post" action="{{ url('customers/register-post') }}">
                @csrf
                <h1>Đăng ký</h1>
                <input type="text" name="name" placeholder="Họ và tên" class="input-control" required/>
                <input type="text" name="email" placeholder="Email" class="input-control" required/>
                <input type="text" name="address" placeholder="Địa chỉ" class="input-control"/>
                <input type="text" name="phone" placeholder="Số điện thoại" class="input-control"/>
                <input type="password" name="password" placeholder="Password" class="input-control" required/>
                <input type="submit" class="button" value="Đăng ký">
            </form>
        </div>

        <div class="form-container sign-in-container">
            <h1>Nếu chưa có tài khoản, đăng ký ngay thôi!</h1>
        </div>
    </div>
</body>
</html>
